# Canonical URL used by server-rendered metadata.
SITE_URL=http://localhost:3000

# Keep secrets server-only. Never prefix secrets with NEXT_PUBLIC_.

# Public contact number, international format (country code, no leading zero).
WHATSAPP_NUMBER=61409871882

# Generation stays disabled until credentials and protections are configured.
BUSINESS_IDEAS_ENABLED=false
# Direct OpenAI API key. Never commit a real value.
OPENAI_API_KEY=
BUSINESS_IDEAS_MODEL=gpt-6-luna

# Optional, reserved for future Places discovery. Not used by the website-only flow.
GOOGLE_PLACES_API_KEY=

# Production Vercel Firewall SDK rule IDs (not secrets). Publish both rules first.
BUSINESS_IDEAS_IP_RULE=business-ideas-ip
BUSINESS_IDEAS_GLOBAL_RULE=business-ideas-global
